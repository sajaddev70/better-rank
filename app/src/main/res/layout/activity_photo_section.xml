<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/root_container"
        android:background="@color/colorBackground">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/black"
                android:background="@drawable/outline_border_circle"
                android:layout_gravity="start|center_vertical"
                android:padding="12dp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo Section"
                android:textColor="@color/black"
                style="@style/TextVeryLarge"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.Toolbar>



        <!-- Scrollable Area -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@id/btn_check_quality"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Guide Text with CardView and Bullet Icon -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="50dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:id="@+id/card_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">



                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_guide"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="start"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- حالت خالی -->
                <LinearLayout
                    android:id="@+id/layout_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Add from current Airbnb photos"
                        android:textColor="@color/colorOnSurface" />

                    <!-- Carousel Airbnb -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/colorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/pager_airbnb"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"/>


                            <!-- Dots -->
                            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                                android:id="@+id/dotsAirbnb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="8dp"
                                app:dotsCornerRadius="8dp"
                                app:dotsColor="@color/colorTertiary"
                                app:dotsStrokeColor="@color/colorTertiary"
                                app:dotsSize="8dp"
                                app:dotsSpacing="2dp"
                                app:progressMode="true"
                                android:visibility="gone" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- Preview بزرگ -->
                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/img_selected_preview"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_container_background"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:riv_corner_radius="16dp" />
                </LinearLayout>

                <!-- حالت عکس دارد (موجود) -->
                <LinearLayout
                    android:id="@+id/layout_has_photos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select one"
                        style="@style/TextLarge"/>

                    <!-- Carousel Existing -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/colorSurface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/pager_existing"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"/>


                            <!-- Dots -->
                            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                                android:id="@+id/dotsExisting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:paddingTop="8dp"
                                app:dotsCornerRadius="8dp"
                                app:dotsColor="@color/colorTertiary"
                                app:dotsStrokeColor="@color/colorTertiary"
                                app:dotsSize="8dp"
                                app:dotsSpacing="2dp"
                                app:progressMode="true"
                                android:visibility="gone" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>



                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_replace"
            style="@style/TertiaryButtonGradient1"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:text="Replace"
            android:textColor="@color/button_text_toggle"
            android:enabled="false"
            android:alpha="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/or"
            android:layout_marginTop="24dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/or"
            app:layout_constraintBottom_toTopOf="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            android:layout_gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginVertical="12dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add"
            style="@style/PrimaryButtonGradient"
            android:layout_width="220dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="16dp"
            android:text="Add"/>

        <!-- ========== NEW BOTTOM BUTTONS LAYOUT (REPLACED SECTION) ========== -->

        <!-- Check Photo Quality Button (now on top) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_check_quality"
            style="@style/TertiaryButtonGradient1"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Check this photo"
            android:textColor="@color/button_text_toggle"
            android:alpha="0.3"
            android:enabled="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_or_bottom"
            android:layout_marginBottom="12dp" />

        <!-- "or" text between Check and Take Photo -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_or_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_take_photo"
            android:layout_marginBottom="12dp" />

        <!-- Take a New Photo (moved below "or") -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_take_photo"
            style="@style/PrimaryButtonGradient"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Take a New Photo"
            android:drawableTint="@color/colorOnPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_gallery"
            android:layout_marginBottom="8dp" />

        <!-- Pick from Gallery (remains at the very bottom) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_gallery"
            style="@style/PrimaryButtonGradient"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Pick from Mobile Gallery"
            android:drawableTint="@color/colorOnPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="24dp" />

        <!-- Keep your existing overlay at the end -->
        <FrameLayout
            android:id="@+id/dialog_overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:elevation="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>