<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="viewModel" type="com.marvelous.betterrank.viewModel.HomeGuideViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FIXED: Home Guide Card (Always on top) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_home_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginEnd="@dimen/margin_end"
            android:layout_marginTop="@dimen/margin_top"
            app:cardCornerRadius="@dimen/default_radius"
            app:contentPadding="@dimen/default_padding"
            app:cardElevation="@dimen/default_elevation">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/ic_home_guide"
                    android:id="@+id/img_homeGuide"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/img_homeGuide"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:text="@string/home_guide"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextSmall"
                        android:textColor="@color/colorOnSurface"
                        android:text="@string/travel_tips_local_insights"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_top_very_small"
                        style="@style/TextVerySmall"
                        android:maxLines="2"
                        android:textColor="@color/colorOnSurface"
                        android:text="@string/all_you_need_to_know_to_explore_the_home"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- City -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_top">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:layout_marginStart="@dimen/margin_start"
                        android:maxLines="1"
                        android:textColor="@color/colorOnBackground"
                        android:text="City"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/default_height"
                        android:inputType="text"
                        android:maxLines="1"
                        android:layout_marginTop="@dimen/margin_top_very_small"
                        style="@style/BackgroundContainerEditText1"
                        android:textColor="@color/colorOnBackgroundContainer"
                        android:padding="2dp"
                        android:hint=""
                        android:text="@={viewModel.resultUpdateHomeGuide.city}"/>
                </LinearLayout>

                <!-- Welcome Note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_top">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:layout_marginStart="@dimen/margin_start"
                        android:maxLines="1"
                        android:textColor="@color/colorOnBackground"
                        android:text="Welcome note"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_top_very_small"
                        android:minHeight="@dimen/default_height"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="5"
                        android:gravity="top|start"
                        style="@style/BackgroundContainerEditText1"
                        android:textColor="@color/colorOnBackgroundContainer"
                        android:padding="2dp"
                        android:hint=""
                        android:text="@={viewModel.resultUpdateHomeGuide.welcomeNote}"/>
                </LinearLayout>

                <!-- Host Intro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_top">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:layout_marginStart="@dimen/margin_start"
                        android:maxLines="1"
                        android:textColor="@color/colorOnBackground"
                        android:text="Host intro"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_top_very_small"
                        android:minHeight="@dimen/default_height"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="5"
                        android:gravity="top|start"
                        style="@style/BackgroundContainerEditText1"
                        android:textColor="@color/colorOnBackgroundContainer"
                        android:padding="2dp"
                        android:hint=""
                        android:text="@={viewModel.resultUpdateHomeGuide.hostIntro}"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>