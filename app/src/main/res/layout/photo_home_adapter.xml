<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="photo"
            type="com.marvelous.betterrank.model.PhotoModel" />

        <variable
            name="isSelected"
            type="Boolean" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_small"
        android:layout_marginBottom="@dimen/margin_bottom_very_small"
        app:cardCornerRadius="@dimen/default_radius"
        app:cardElevation="@dimen/default_elevation"
        app:contentPadding="@dimen/default_padding_small">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <!-- Checkbox -->
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cb_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="@{isSelected}"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="8dp" />

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/img_image"
                android:layout_width="120dp"
                android:layout_height="80dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:riv_corner_radius="@dimen/default_radius"
                android:scaleType="centerCrop"
                imageLoadByUrl="@{photo.url}" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_start_so_small"
                android:layout_marginEnd="@dimen/margin_end_so_small"
                app:layout_constraintTop_toTopOf="@id/img_image"
                app:layout_constraintBottom_toBottomOf="@id/img_image"
                app:layout_constraintStart_toEndOf="@id/img_image"
                app:layout_constraintEnd_toStartOf="@id/cb_select"
                android:gravity="center_vertical"
                style="@style/TextMedium"
                android:textColor="@color/colorOnSurface"
                android:text="@{photo.title}" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>