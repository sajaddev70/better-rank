<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="viewModel" type="com.marvelous.betterrank.viewModel.HomeGuideViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tint="@color/colorOnPrimary"
                    app:srcCompat="@drawable/ic_edit_text"
                    android:padding="@dimen/default_padding_small"
                    android:background="@drawable/primary_background_gradient2"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:text="Check out"/>
            </LinearLayout>

            <!-- Check-out Window -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginTop="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Check-out window"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.checkOutWindow}" />

            <!-- Departure Checklist -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Departure checklist"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/BackgroundContainerEditText1"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:gravity="top|start"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.departureChecklist}" />

            <!-- Where to Leave Keys -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Where to leave the keys"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/BackgroundContainerEditText1"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:gravity="top|start"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.whereToLeaveKeys}" />

        </LinearLayout>
    </ScrollView>
</layout>