<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layoutDirection="ltr">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top"
            android:layout_marginStart="@dimen/margin_start"
            android:padding="@dimen/default_padding_small"
            android:background="@drawable/outline_border_circle"
            app:srcCompat="@drawable/ic_close"
            android:tint="@color/colorOnSurface"
            android:id="@+id/img_close" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginTop="@dimen/margin_top"
            style="@style/TextVeryLarge"
            android:textColor="@color/colorOnSurface"
            android:text="@string/logout_or_delete_account" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginTop="@dimen/margin_top_small"
            style="@style/TextMedium"
            android:textColor="@color/colorOnSurface"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_top_big"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logout"
                android:paddingStart="@dimen/default_padding_so_small"
                android:paddingEnd="@dimen/default_padding_so_small"
                android:layout_marginStart="@dimen/margin_start_small"
                android:layout_marginEnd="@dimen/margin_end_so_small"
                style="@style/SurfaceButton"
                android:id="@+id/btn_logout" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete_account"
                android:paddingStart="@dimen/default_padding_so_small"
                android:paddingEnd="@dimen/default_padding_so_small"
                android:layout_marginStart="@dimen/margin_start_so_small"
                android:layout_marginEnd="@dimen/margin_end_small"
                style="@style/SurfaceButton"
                android:id="@+id/btn_delete" />

        </LinearLayout>

    </LinearLayout>
</layout>