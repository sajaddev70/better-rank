<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="viewModel" type="com.marvelous.betterrank.viewModel.HomeGuideViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tint="@color/colorOnPrimary"
                    app:srcCompat="@drawable/ic_document"
                    android:padding="@dimen/default_padding_small"
                    android:background="@drawable/primary_background_gradient2"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:text="Neighborhood"/>
            </LinearLayout>

            <!-- 24-hour pharmacy -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="@dimen/margin_start"

                android:text="24-hour pharmacy"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.pharmacy}" />

            <!-- Groceries -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Groceries &amp; convenience stores"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.groceries}" />

            <!-- ATMs -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="ATMs, banks &amp; currency exchange"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.atms}" />

            <!-- SIM cards -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="SIM cards &amp; mobile stores"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.simCards}" />

            <!-- Parks -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Parks, playgrounds &amp; fitness"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.parks}" />

            <!-- Metro -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Nearby metro/bus/tram stops"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.metro}" />

            <!-- Food delivery -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Food delivery apps &amp; grocery delivery"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.foodDelivery}" />

            <!-- Breakfast -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Breakfast, cafés &amp; bakeries"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.breakfast}" />

            <!-- Lunch/Dinner -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Lunch/Dinner by cuisine &amp; dietary needs"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.lunchDinner}" />

            <!-- Late-night -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Late-night options"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:minLines="5"
                android:gravity="top|start"
                style="@style/BackgroundContainerEditText1"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.lateNight}" />

            <!-- Top 5 attractions -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="4dp"
                android:text="Top 5 attractions nearby"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/BackgroundContainerEditText1"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:gravity="top|start"
                android:padding="2dp"
                android:text="@={viewModel.resultUpdateHomeGuide.topAttractions}" />

        </LinearLayout>
    </ScrollView>
</layout>