<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.marveloushost.betterrank.viewModel.HomeViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/surface_background1"
                    android:padding="@dimen/default_padding_very_small"
                    android:layout_marginTop="@dimen/margin_top_small"
                    android:layout_marginStart="@dimen/margin_start_small"
                    android:layout_marginEnd="@dimen/margin_end_small"
                    android:id="@+id/cl_profile">

                    <com.mikhaellopez.circularimageview.CircularImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        imageLoadByUrl="@{viewModel.resultGetUser.photoUrl}"/>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_small_logo"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/margin_start_so_small">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextMedium"
                                android:textColor="@color/colorOnSurface"
                                android:textStyle="bold"
                                android:text="@string/app_name"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextSmall"
                                android:textColor="@color/colorOnSurface"
                                android:text="@string/by_marvelous_host"/>

                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:text="Log out"
                        style="@style/ButtonDefault2"
                        android:background="@drawable/surface_background"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:tint="@color/colorOnSurface"
                        android:padding="@dimen/default_padding_small"
                        android:id="@+id/btn_logout"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    app:cardCornerRadius="@dimen/default_radius"
                    app:contentPadding="@dimen/default_padding"
                    app:cardElevation="@dimen/default_elevation"
                    android:layout_marginTop="@dimen/margin_top_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/pager"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:scaleType="matrix"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                                android:id="@+id/dots_indicator"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btn_reload"
                                android:layout_marginEnd="@dimen/margin_end_small"
                                android:layout_marginTop="@dimen/margin_top_very_small"
                                app:dotsColor="@color/colorTertiary"
                                app:dotsStrokeColor="@color/white"
                                app:dotsCornerRadius="8dp"
                                app:dotsSize="8dp"
                                app:dotsSpacing="2dp"
                                app:dotsStrokeWidth="4dp"
                                app:progressMode="true"/>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_reload"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/default_height_small"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginEnd="10dp"
                                android:layout_marginTop="@dimen/margin_top_very_small"
                                android:paddingHorizontal="@dimen/default_padding_small"
                                style="@style/ButtonDefault2"
                                android:background="@drawable/surface_background"
                                android:text="@string/update" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_top_small">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/txt_rate"
                                android:layout_marginEnd="@dimen/margin_end_so_small"
                                android:textStyle="bold"
                                style="@style/TextMedium"
                                android:textColor="@color/colorOnSurface"
                                android:text="@{viewModel.resultGetHome.airBnbResponseModel.listingName}"
                                android:id="@+id/txt_listingName"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toBottomOf="@id/txt_listingName"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/txt_rate"
                                android:layout_marginEnd="@dimen/margin_end_so_small"
                                android:textStyle="bold"
                                style="@style/TextSmall"
                                android:textColor="@color/colorOnSurface"
                                android:text="@{viewModel.resultGetHome.airBnbResponseModel.detailsText}"
                                />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                style="@style/TextSmall"
                                android:textColor="@color/colorOnSurface"
                                android:drawableEnd="@drawable/ic_star_small"
                                android:drawablePadding="@dimen/default_padding_so_small"
                                android:text="@{viewModel.resultGetHome.airBnbResponseModel.ratings+``}"
                                android:id="@+id/txt_rate"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/margin_top_small"
                            android:weightSum="2">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_maintenanceTasks"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/default_height_medium"
                                android:layout_weight="1"
                                style="@style/PrimaryButtonGradient2"

                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                android:paddingStart="@dimen/default_padding_so_small"
                                android:paddingEnd="@dimen/default_padding_so_small"
                                android:layout_marginEnd="@dimen/margin_end_so_small"
                                app:iconTint="@color/colorOnPrimary"
                                android:text="@string/photography"
                                android:gravity="center"
                                android:background="@drawable/primary_background_gradient"
                                app:backgroundTint="@null"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_reviews"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/default_height_medium"
                                android:layout_weight="1"
                                style="@style/TertiaryButtonGradient2"
                                app:iconGravity="textStart"
                                app:iconPadding="12dp"
                                android:paddingStart="@dimen/default_padding_so_small"
                                android:paddingEnd="@dimen/default_padding_so_small"
                                android:layout_marginStart="@dimen/margin_start_so_small"
                                app:iconTint="@color/colorOnTertiary"
                                android:text="@string/reviews"
                                android:gravity="center"
                                android:background="@drawable/tertiary_background_gradient"
                                app:backgroundTint="@null"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>



                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tertiary_background_gradient2"
                    android:padding="@dimen/default_padding_very_small"
                    android:layout_marginTop="@dimen/margin_top_small"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:srcCompat="@drawable/ic_ai_assistant"
                        android:id="@+id/img_aiAssistant"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/img_aiAssistant"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextMedium"
                            android:textStyle="bold"
                            android:paddingStart="@dimen/default_padding_so_small"
                            android:paddingEnd="@dimen/default_padding_so_small"
                            android:textColor="@color/colorOnPrimary"
                            android:text="Let AI analyze your Airbnb page and give you smart tips."/>



                        <androidx.appcompat.widget.AppCompatButton
                            android:layout_width="@dimen/default_width"
                            android:layout_height="@dimen/default_height_small"
                            android:layout_marginTop="@dimen/margin_top_small"
                            style="@style/PrimaryButtonGradient2"
                            android:paddingStart="@dimen/default_padding_small"
                            android:paddingEnd="@dimen/default_padding_small"
                            android:text="@string/start"
                            android:enabled="@{!viewModel.isLoading}"
                            android:id="@+id/btn_aiCityGuide" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>



                <!-- City Guide (LEFT) + Home Guide (RIGHT) — ONE ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_top_small"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <!-- CITY GUIDE CARD (LEFT) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:minHeight="130dp"
                        app:cardCornerRadius="@dimen/default_radius"
                        app:cardElevation="@dimen/default_elevation"
                        android:background="@drawable/primary_background_gradient2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:minHeight="130dp"
                            android:background="@drawable/primary_background_gradient2"
                            android:padding="@dimen/default_padding">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextMedium"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnPrimary"
                                android:text="@string/city_guide" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_top_small"
                                style="@style/TextSmall"
                                android:gravity="center"
                                android:minLines="3"
                                android:textColor="@color/colorOnPrimary"
                                android:text="@{viewModel.resultGetHome.airBnbResponseModel.cityTravelTips}" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_cityGuide"
                                style="@style/TertiaryButtonGradient2"
                                android:layout_width="@dimen/default_width"
                                android:layout_height="@dimen/default_height_small"
                                android:layout_marginTop="@dimen/margin_top_small"
                                android:enabled="@{!viewModel.isLoading}"
                                android:paddingStart="@dimen/default_padding_small"
                                android:paddingEnd="@dimen/default_padding_small"
                                android:text="Edit"
                                app:backgroundTint="@null" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- HOME GUIDE CARD (RIGHT) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="130dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="@dimen/default_radius"
                        app:cardElevation="@dimen/default_elevation"
                        android:background="@drawable/tertiary_background_gradient2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="130dp"
                            android:background="@drawable/primary_background_gradient2"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="@dimen/default_padding">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextMedium"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnPrimary"
                                android:text="@string/home_guide" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_top_small"
                                style="@style/TextSmall"
                                android:gravity="center"
                                android:minLines="3"
                                android:textColor="@color/colorOnPrimary"
                                android:text="@string/everything_about_the_property" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_homeGuide"
                                android:layout_width="@dimen/default_width"
                                android:layout_height="@dimen/default_height_small"
                                android:layout_marginTop="@dimen/margin_top_small"
                                style="@style/TertiaryButtonGradient2"
                                android:paddingStart="@dimen/default_padding_small"
                                android:paddingEnd="@dimen/default_padding_small"
                                android:text="Edit"
                                android:enabled="@{!viewModel.isLoading}"
                                app:backgroundTint="@null" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    app:cardCornerRadius="@dimen/default_radius"
                    app:cardElevation="@dimen/default_elevation"
                    android:layout_marginTop="@dimen/margin_top_small"
                    android:layout_marginBottom="@dimen/margin_bottom">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tertiary_background_gradient2">  <!-- ← HERE -->

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:srcCompat="@drawable/ic_maintenance_tasks"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:id="@+id/img_maintenanceTasks"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/img_maintenanceTasks"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TextMedium"
                                android:textStyle="bold"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textColor="@color/white"
                                android:text="@string/pdf_guide"/>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_pdf"
                                android:layout_width="@dimen/default_width"
                                android:layout_height="@dimen/default_height_small"
                                android:layout_marginTop="@dimen/margin_top_small"
                                android:layout_marginStart="10dp"
                                style="@style/PrimaryButtonGradient2"
                                android:paddingStart="@dimen/default_padding_so_small"
                                android:paddingEnd="@dimen/default_padding_so_small"
                                android:text="@string/PDF"
                                android:enabled="@{!viewModel.isLoading}"
                                app:backgroundTint="@null" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <include
            layout="@layout/loading"
            android:id="@+id/baseLoading"
            android:visibility="@{viewModel.isLoading?View.VISIBLE:View.GONE,default=gone}"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>