<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="viewModel" type="com.marveloushost.betterrank.viewModel.HomeGuideViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:tint="@color/colorOnPrimary"
                    app:srcCompat="@drawable/ic_kitchen"
                    android:padding="@dimen/default_padding_small"
                    android:background="@drawable/primary_background_gradient2"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:text="Check in"/>
            </LinearLayout>

            <!-- How to Get In -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_top_big"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="How to get in"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="5"
                    android:gravity="top|start"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.howToGetIn}" />
            </LinearLayout>

            <!-- Entrance Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Entrance Code"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_height"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.entranceCode}" />
            </LinearLayout>

            <!-- Check in Window -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Check in window"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_height"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.checkInWindow}" />
            </LinearLayout>

            <!-- Additional Access -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Additional access/entrance info"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="5"
                    android:gravity="top|start"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.additionalAccess}" />
            </LinearLayout>

            <!-- Floor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Floor"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_height"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.floor}" />
            </LinearLayout>

            <!-- Stairs/Elevator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Stairs, elevator, other info"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="5"
                    android:gravity="top|start"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.stairsElevator}" />
            </LinearLayout>

            <!-- Parking Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextMedium"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginBottom="8dp"
                android:textColor="@color/colorOnBackground"
                android:text="Parking"/>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/rg_parking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginEnd="@dimen/margin_start"
                android:layout_marginBottom="20dp"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="flex_start">

                <RadioButton
                    android:id="@+id/rb_street"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="On Street"
                    android:checked="@{viewModel.resultUpdateHomeGuide.parking == `On Street`}"
                    android:onClick="@{() -> viewModel.setParking(`On Street`)}" />

                <RadioButton
                    android:id="@+id/rb_lot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="Lot"
                    android:checked="@{viewModel.resultUpdateHomeGuide.parking == `Lot`}"
                    android:onClick="@{() -> viewModel.setParking(`Lot`)}" />

                <RadioButton
                    android:id="@+id/rb_none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="None"
                    android:checked="@{viewModel.resultUpdateHomeGuide.parking == `None`}"
                    android:onClick="@{() -> viewModel.setParking(`None`)}" />
            </com.google.android.flexbox.FlexboxLayout>

            <!-- Parking Comments -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Comments"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="5"
                    android:gravity="top|start"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    android:padding="2dp"
                    android:hint=""
                    android:text="@={viewModel.resultUpdateHomeGuide.parkingComments}" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</layout>