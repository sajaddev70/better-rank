<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.marvelous.betterrank.viewModel.MainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cd_bottomNavigation"
            android:visibility="@{viewModel.whichFragment==1?View.VISIBLE:View.GONE,default=gone}"
            android:id="@+id/fl_home"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cd_bottomNavigation"
            android:visibility="@{viewModel.whichFragment==2?View.VISIBLE:View.GONE,default=gone}"
            android:id="@+id/fl_guests"/>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cd_bottomNavigation"
            android:visibility="@{viewModel.whichFragment==3?View.VISIBLE:View.GONE,default=gone}"
            android:id="@+id/fl_messages"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cd_bottomNavigation"
            android:visibility="@{viewModel.whichFragment==4?View.VISIBLE:View.GONE,default=gone}"
            android:id="@+id/fl_notes"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cd_bottomNavigation"
            app:cardElevation="@dimen/default_elevation"
            app:cardCornerRadius="0dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
                app:labelVisibilityMode="labeled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/colorSurface"
                app:itemIconSize="24dp"
                app:itemTextColor="@color/navigation_color"
                app:itemIconTint="@color/navigation_color"
                app:elevation="8dp"
                app:menu="@menu/bottom_menu" />

        </androidx.cardview.widget.CardView>

        <include
            layout="@layout/loading"
            android:id="@+id/baseLoading"
            android:visibility="@{viewModel.isLoading?View.VISIBLE:View.GONE,default=gone}"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>