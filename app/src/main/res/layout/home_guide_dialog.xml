<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layoutDirection="ltr">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top"
            android:layout_marginStart="@dimen/margin_start"
            android:padding="@dimen/default_padding_small"
            android:background="@drawable/outline_border_circle"
            app:srcCompat="@drawable/ic_close"
            android:tint="@color/colorOnSurface"
            android:id="@+id/img_close" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginEnd="@dimen/margin_end"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/ic_home_guide_big"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/TextVeryLarge"
            android:gravity="center"
            android:textAlignment="gravity"
            android:textColor="@color/colorOnSurface"
            android:text="@string/home_guide_created"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/TextMedium"
            android:gravity="center"
            android:textAlignment="gravity"
            android:textColor="@color/colorOnSurface"
            android:text="@string/all_you_need_to_know_to_explore_the_home"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/PrimaryButtonGradient"
            android:drawableTint="@color/colorOnBackground"
            android:text="@string/go_home_page"
            android:id="@+id/btn_home"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top"
            style="@style/TertiaryButtonGradient1"
            android:drawableTint="@color/colorOnTertiary"
            android:drawableStart="@drawable/ic_download"
            android:paddingStart="@dimen/default_padding_so_small"
            android:paddingEnd="@dimen/default_padding_so_small"
            android:text="@string/preview"
            android:id="@+id/btn_preview"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top"
            style="@style/TertiaryButtonGradient1"
            android:drawableTint="@color/colorOnTertiary"
            android:drawableStart="@drawable/ic_download"
            android:paddingStart="@dimen/default_padding_so_small"
            android:paddingEnd="@dimen/default_padding_so_small"
            android:text="@string/share_pdf"
            android:id="@+id/btn_share"/>

    </LinearLayout>
</layout>