<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"

        android:layoutDirection="ltr">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top"
            android:layout_marginStart="@dimen/margin_start"
            android:padding="@dimen/default_padding_small"
            android:background="@drawable/outline_border_circle"
            app:srcCompat="@drawable/ic_close"
            android:tint="@color/colorOnSurface"
            android:id="@+id/img_close" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginEnd="@dimen/margin_end"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/ic_problem_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/TextVeryLarge"
            android:gravity="center"
            android:textAlignment="gravity"
            android:id="@+id/txt_title"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginEnd="@dimen/margin_end"
            style="@style/TextMedium"
            android:gravity="center"
            android:textAlignment="gravity"
            android:textColor="@color/colorOnSurface"
            android:text="@string/to_register_information_you_can_either_upload"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/PrimaryButtonGradient"
            android:drawableTint="@color/colorOnBackground"
            android:text="@string/try_again"
            android:id="@+id/btn_tryAgain"/>



    </LinearLayout>
</layout>