<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable name="viewModel" type="com.marvelous.betterrank.viewModel.HomeGuideViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Action Bar -->
        <include layout="@layout/action_bar" android:id="@+id/baseActionBar" />



        <!-- ViewPager2 for Sections (Full height from ActionBar) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/baseActionBar"
            app:layout_constraintBottom_toTopOf="@id/bottomBar" />

        <!-- Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Page Counter -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txt_page_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{String.format(`%d of %d`, viewModel.currentPosition + 1, viewModel.totalPages)}"
                android:textColor="@color/colorOnSurface"
                style="@style/TextSmall"
                android:layout_marginBottom="8dp" />

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Back Button -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SurfaceButtonCircle"
                    android:src="@drawable/ic_arrow_left"
                    android:tint="@color/colorOnSurface"
                    android:padding="@dimen/default_padding"
                    android:layout_marginEnd="16dp"
                    android:onClick="@{() -> viewModel.previousPage()}" />

                <!-- Next Button (Pages 0–1) -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/PrimaryButtonCircle"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/colorOnPrimary"
                    android:padding="@dimen/default_padding"
                    android:visibility="@{viewModel.isLastPage ? View.GONE : View.VISIBLE}"
                    android:onClick="@{() -> viewModel.nextPage()}" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done"
                    style="@style/PrimaryButtonRounded"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    app:backgroundTint="@null"
                    android:layout_marginTop="-4dp"
                    android:textAllCaps="false"

                    android:text="Done"
                    android:visibility="@{viewModel.isLastPage ? View.VISIBLE : View.GONE}"
                    android:onClick="@{() -> viewModel.nextPage()}" />

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/loading"
            android:id="@+id/baseLoading"
            android:visibility="@{viewModel.isLoading ? View.VISIBLE : View.GONE}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>