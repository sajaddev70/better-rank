<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.marveloushost.betterrank.viewModel.CreateNoteViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">

        <include layout="@layout/action_bar"
            android:id="@+id/baseActionBar"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/baseActionBar"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginEnd="@dimen/margin_end"
                app:cardCornerRadius="@dimen/default_radius"
                app:contentPadding="@dimen/default_padding"
                app:cardElevation="@dimen/default_elevation"
                android:layout_marginTop="@dimen/margin_top">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:srcCompat="@drawable/note_small"
                        android:id="@+id/img_note"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/img_note"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextMedium"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:text="@string/what_is_note"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextSmall"
                            android:textColor="@color/colorOnSurface"
                            android:text="@string/how_to_take_high_quality_and_attractive"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_top_big">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="Title"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_height"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_marginTop="@dimen/margin_top_very_small"
                    style="@style/BackgroundContainerEditText1"
                    android:textColor="@color/colorOnBackgroundContainer"
                    app:drawableTint="@color/colorOnBackgroundContainer"
                    android:hint="@string/enter_note_name"
                    android:text="@={viewModel.note.title}"/>

            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/default_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                >

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/img_mic"
                    android:layout_marginEnd="@dimen/margin_end_very_small"
                    android:minHeight="@dimen/default_height"
                    android:inputType="textMultiLine"
                    style="@style/BackgroundContainerEditText2"
                    android:layout_marginStart="@dimen/margin_start"
                    android:textColor="@color/colorOnBackgroundContainer"
                    app:drawableTint="@color/colorOnBackgroundContainer"
                    android:gravity="center_vertical|start"
                    android:hint="@string/type_a_message"
                    android:text="@={viewModel.note.message}"
                    android:id="@+id/et_message"/>

                <com.marveloushost.betterrank.customView.VoiceWaveView
                    android:id="@+id/voiceWaveView"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/default_height"
                    app:layout_constraintTop_toTopOf="@id/et_message"
                    app:layout_constraintBottom_toBottomOf="@id/et_message"
                    app:layout_constraintStart_toStartOf="@id/et_message"
                    app:layout_constraintEnd_toEndOf="@id/et_message"
                    android:padding="@dimen/default_padding"
                    android:elevation="3dp"
                    android:visibility="gone"/>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/et_message"
                    app:layout_constraintBottom_toBottomOf="@id/et_message"
                    android:src="@drawable/ic_mic"
                    android:padding="@dimen/default_padding_small"
                    style="@style/PrimaryButtonGradient2"
                    android:id="@+id/img_mic"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/switch_reminded"
                    app:layout_constraintBottom_toBottomOf="@id/switch_reminded"
                    style="@style/TextMedium"
                    android:layout_marginStart="@dimen/margin_start"
                    android:maxLines="1"
                    android:textColor="@color/colorOnBackground"
                    android:text="@string/do_you_want_to_be_reminded"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:checked="@{viewModel.reminded}"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:id="@+id/switch_reminded"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/default_height"
                    android:layout_marginStart="@dimen/margin_start"
                    app:layout_constraintTop_toBottomOf="@id/switch_reminded"
                    android:orientation="horizontal"
                    android:id="@+id/li_startAt"
                    android:visibility="@{viewModel.reminded==true?View.VISIBLE:View.GONE,default=gone}">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextSmall"
                        android:textStyle="bold"
                        android:text="@string/reminded"
                        android:textColor="@color/colorOnSurface"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextSmall"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/margin_start_so_small"
                        android:textColor="@color/colorTertiary"
                        android:text="@{viewModel.startAt==0?@string/start_at:viewModel.timestampToDateTime(viewModel.startAt)}"/>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_big"
                style="@style/PrimaryButtonGradient"
                android:drawableTint="@color/colorOnBackground"
                android:text="@{viewModel.note.id.equals(``)? @string/create_now:@string/update,default=@string/create_now}"
                android:enabled="@{!viewModel.isLoading}"
                android:onClick="@{()->viewModel.validationAndCreateNote()}"
                android:id="@+id/btn_apply"/>

        </LinearLayout>



        <include
            layout="@layout/loading"
            android:id="@+id/baseLoading"
            android:visibility="@{viewModel.isLoading?View.VISIBLE:View.GONE,default=gone}"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>