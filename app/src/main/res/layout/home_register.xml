<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.marvelous.betterrank.viewModel.HomeRegisterViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSurface"
        android:layoutDirection="ltr">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="@dimen/margin_top_big"
            android:id="@+id/li_topBar">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_small_logo"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/margin_start_small">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextLarge"
                    android:textColor="@color/colorOnSurface"
                    android:textStyle="bold"
                    android:text="@string/app_name"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnSurface"
                    android:text="@string/by_marvelous_host"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/li_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/li_topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/margin_top_small"> <!-- Reduced margin for tighter spacing -->

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginEnd="@dimen/margin_end"
                app:srcCompat="@drawable/register_home"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_small"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginEnd="@dimen/margin_end"
                style="@style/TextVeryLarge"
                android:gravity="center"
                android:textAlignment="gravity"
                android:textColor="@color/colorOnSurface"
                android:id="@+id/txt_title"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_small"
                android:layout_marginStart="@dimen/margin_start"
                android:layout_marginEnd="@dimen/margin_end"
                style="@style/TextSmall"
                android:gravity="center"
                android:textAlignment="gravity"
                android:textColor="@color/colorOnSurface"
                android:text="@string/to_register_your_property_you_can_either_enter_its_airbnb"/>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/li_header"
            app:layout_constraintBottom_toTopOf="@id/btn_check"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">



                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    app:cardCornerRadius="@dimen/default_radius"
                    app:contentPadding="@dimen/default_padding_small"
                    app:cardElevation="@dimen/default_elevation"
                    android:layout_marginBottom="@dimen/margin_bottom"
                    android:layout_marginTop="@dimen/margin_top">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/default_height"
                            android:inputType="text"
                            android:maxLines="1"
                            android:layout_marginTop="@dimen/margin_top_big"
                            style="@style/BackgroundContainerEditText2"
                            android:textColor="@color/colorOnBackgroundContainer"
                            android:drawableStart="@drawable/ic_link"
                            app:drawableTint="@color/colorOnBackgroundContainer"
                            android:hint="@string/airbnb_link_url"
                            android:paddingStart="@dimen/default_padding_small"
                            android:paddingEnd="@dimen/default_padding_small"
                            android:id="@+id/et_link"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_top"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/margin_end_small"
                                android:background="@color/colorOutline"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/or"
                                style="@style/TextMedium"
                                android:textColor="@color/colorOnSurface"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/margin_start_small"
                                android:background="@color/colorOutline"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="@dimen/margin_top"
                            android:layout_marginBottom="@dimen/margin_bottom_big"
                            android:gravity="center"
                            android:padding="@dimen/default_padding_small"
                            android:background="@drawable/outline_border_dash">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:tint="@color/colorOnSurface"
                                app:srcCompat="@drawable/ic_image"/>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_top_small"
                                style="@style/TextMedium"
                                android:gravity="center"
                                android:textAlignment="gravity"
                                android:textColor="@color/colorOnSurface"
                                android:text="@string/upload_a_photo_of_property_page"/>

                            <!-- Camera & Gallery Buttons (Same style as Upload) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="@dimen/margin_top"
                                android:layout_marginBottom="@dimen/margin_bottom_big">

                                <!-- Camera Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_camera"
                                    style="@style/PrimaryButtonGradient"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/default_height_medium"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    app:icon="@drawable/ic_camera"
                                    app:iconTint="@color/colorOnPrimary"
                                    app:iconGravity="textStart"
                                    app:iconPadding="4dp"
                                    android:text="@string/take_photo"
                                    android:enabled="@{!viewModel.isLoading}"
                                    app:backgroundTint="@null"/>

                                <!-- Gallery Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_gallery"
                                    style="@style/PrimaryButtonGradient"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/default_height_medium"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    app:icon="@drawable/ic_gallery"
                                    app:iconTint="@color/colorOnPrimary"
                                    app:iconGravity="textStart"
                                    app:iconPadding="4dp"
                                    android:text="@string/chose_picture"
                                    android:enabled="@{!viewModel.isLoading}"
                                    app:backgroundTint="@null"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/margin_bottom"
            style="@style/PrimaryButtonGradient"
            android:drawableTint="@color/colorOnBackground"
            android:text="@string/retrieve_from_airbnb"
            android:enabled="@{!viewModel.isLoading}"
            android:id="@+id/btn_check"/>

        <include
            layout="@layout/loading"
            android:id="@+id/baseLoading"
            android:visibility="@{viewModel.isLoading?View.VISIBLE:View.GONE,default=gone}"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>