<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <import type="com.marvelous.betterrank.viewModel.GuestsViewModel" />
        <variable
            name="viewModel"
            type="com.marvelous.betterrank.viewModel.GuestsViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/headerScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Add Guests Cards -->
                <include
                    android:id="@+id/addGuestCards"
                    layout="@layout/include_add_guest_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:viewModel="@{viewModel}" />

                <!-- Header + Segmented Control (SWITCH IN FRONT) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvListOfGuests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="List Of Guests"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- iOS Segmented Control (IN FRONT) -->
                    <FrameLayout
                        android:id="@+id/segmentContainer"
                        android:layout_width="160dp"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:background="@drawable/segment_background"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <View
                            android:id="@+id/slidingPill"
                            android:layout_width="76dp"
                            android:layout_height="36dp"
                            android:layout_margin="4dp"
                            android:background="@drawable/segment_pill"
                            android:layout_gravity="start" />

                        <TextView
                            android:id="@+id/tvCalendar"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Calendar"
                            android:textSize="13sp"
                            android:layout_gravity="start" />

                        <TextView
                            android:id="@+id/tvByGuests"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="By Guests"
                            android:textSize="13sp"
                            android:layout_gravity="end" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerScroll"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>