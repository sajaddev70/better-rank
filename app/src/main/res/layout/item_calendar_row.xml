<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- No variables needed -->
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- PILL ROW OVERLAY -->
        <LinearLayout
            android:id="@+id/pillRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:elevation="10dp"
            android:translationZ="10dp"
            android:translationY="6dp">

            <TextView
                android:id="@+id/pill1"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/pill2"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/pill3"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/pill4"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/pill5"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/pill6"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/pill7"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- DAY CELLS ROW (below the pills) -->
        <LinearLayout
            android:id="@+id/dayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/row_rounded_bg"
            android:layout_marginBottom="8dp"
            android:padding="4dp">

        <!-- Day 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />


            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 1 -->
        <View
            android:id="@+id/separator1"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />



            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 2 -->
        <View
            android:id="@+id/separator2"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />



            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 3 -->
        <View
            android:id="@+id/separator3"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />




            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 4 -->
        <View
            android:id="@+id/separator4"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 5 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />




            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 5 -->
        <View
            android:id="@+id/separator5"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 6 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />



            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Vertical Separator 6 -->
        <View
            android:id="@+id/separator6"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <!-- Day 7 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/dayCard7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="2dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:gravity="center|top"
                android:padding="1dp">

                <TextView
                    android:id="@+id/tvDayNumber7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />



            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</FrameLayout>
</layout>