<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.marvelous.betterrank.viewModel.PhotographyGuideViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr">

        <include layout="@layout/action_bar"
            android:id="@+id/baseActionBar"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/baseActionBar"
            app:layout_constraintBottom_toTopOf="@id/btn_startNow"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/colorSurface">
            <LinearLayout
                android:id="@+id/card_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_small"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Good photos sell your space before guests even read a single word. They create trust, emotion, and the feeling of “I want to stay there.” A few simple choices can make all the difference."/>
            </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top"
                    style="@style/TextMedium"
                    android:textStyle="bold"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:text="Photography Steps"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/colorOnPrimary"
                        app:srcCompat="@drawable/ic_lighting"
                        android:padding="@dimen/default_padding_small"
                        android:background="@drawable/primary_background_gradient2"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/margin_start_so_small"
                        android:textColor="@color/colorOnBackground"
                        android:text="1. Use natural daylight"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_small"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:text="Bright, soft light makes your space look warm and genuine. Avoid flash or harsh yellow bulbs."/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/colorOnPrimary"
                        app:srcCompat="@drawable/ic_angle"
                        android:padding="@dimen/default_padding_small"
                        android:background="@drawable/primary_background_gradient2"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/margin_start_so_small"
                        android:textColor="@color/colorOnBackground"
                        android:text="2. Capture the full story of each room"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_small"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:text="Step back, include corners, and let guests feel how open and comfortable it is."/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/colorOnPrimary"
                        app:srcCompat="@drawable/ic_focus"
                        android:padding="@dimen/default_padding_small"
                        android:background="@drawable/primary_background_gradient2"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/margin_start_so_small"
                        android:textColor="@color/colorOnBackground"
                        android:text="3. Prepare the space as you would for your favorite guest"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_small"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:text="Clear clutter, smooth the bed, and add small touches that feel welcoming."/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/margin_top"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/colorOnPrimary"
                        app:srcCompat="@drawable/ic_camera"
                        android:padding="@dimen/default_padding_small"
                        android:background="@drawable/primary_background_gradient2"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextMedium"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/margin_start_so_small"
                        android:textColor="@color/colorOnBackground"
                        android:text="4. Take photos from eye level and show the view through the windows"/>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_small"
                    style="@style/TextMedium"
                    android:textColor="@color/colorOnBackground"
                    android:layout_marginStart="@dimen/margin_start"
                    android:layout_marginEnd="@dimen/margin_end"
                    android:text="It helps guests imagine waking up there."/>


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top_big"
            android:layout_marginBottom="@dimen/margin_top_big"
            style="@style/PrimaryButtonGradient"
            android:drawableTint="@color/colorOnBackground"
            android:text="Start Now"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/btn_startNow"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>