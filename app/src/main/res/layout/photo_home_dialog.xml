<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="title"
            type="String" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layoutDirection="ltr">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_top"
            android:layout_marginStart="@dimen/margin_start"
            android:padding="@dimen/default_padding_small"
            android:background="@drawable/outline_border_circle"
            app:srcCompat="@drawable/ic_close"
            android:tint="@color/colorOnSurface"
            android:id="@+id/img_close" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginTop="@dimen/margin_top"
            style="@style/TextVeryLarge"
            android:textColor="@color/colorOnSurface"
            android:text="@{title}" />

        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:layout_marginTop="@dimen/margin_top_big"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginEnd="@dimen/margin_end"
            app:riv_corner_radius="@dimen/default_radius"
            android:scaleType="centerCrop"
            android:src="@drawable/photo_home_dialog"/>


        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top_big"
            style="@style/PrimaryButtonGradient"
            app:iconTint="@color/colorOnPrimary"
            app:iconPadding="@dimen/default_padding_so_small"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            android:text="@string/take_photo"
            android:id="@+id/btn_camera"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/margin_top"
            style="@style/TertiaryButtonGradient1"
            app:iconTint="@color/colorOnTertiary"
            app:iconPadding="@dimen/default_padding_so_small"
            app:icon="@drawable/ic_gallery"
            app:iconGravity="textStart"
            android:text="@string/chose_picture"
            android:id="@+id/btn_gallery"
            app:backgroundTint="@null" />

    </LinearLayout>
</layout>