<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>

        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>

        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>

        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorPrimaryContainer</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="fontFamily">@font/font_family_moona_sans</item>
        <item name="android:fontFamily">@font/font_family_moona_sans</item>
    </style>

    <style name="PauseDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowAnimationStyle">@style/PauseDialogAnimation</item>
    </style>
    <style name="PauseDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/pop_in</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/surface_rounded_top</item>
        <item name="android:elevation">@dimen/default_elevation</item>
    </style>

    <style name="EditTextDefault1" parent="TextMedium">
        <item name="android:layout_marginStart">@dimen/margin_start</item>
        <item name="android:layout_marginEnd">@dimen/margin_end</item>
        <item name="android:layout_marginBottom">@dimen/default_margin</item>
        <item name="android:paddingStart">@dimen/default_padding_so_small</item>
        <item name="android:paddingEnd">@dimen/default_padding_so_small</item>
        <item name="android:drawablePadding">@dimen/default_padding_so_small</item>
        <item name="android:elevation">@dimen/default_elevation</item>
    </style>

    <style name="EditTextDefault2" parent="TextMedium">
        <item name="android:layout_marginBottom">@dimen/default_margin</item>
        <item name="android:paddingStart">@dimen/default_padding_so_small</item>
        <item name="android:paddingEnd">@dimen/default_padding_so_small</item>
        <item name="android:drawablePadding">@dimen/default_padding_so_small</item>
        <item name="android:elevation">@dimen/default_elevation</item>
    </style>

    <style name="PrimaryContainerEditText1" parent="EditTextDefault1">
        <item name="drawableTint">@color/colorOnPrimaryContainer</item>
        <item name="android:background">@drawable/primary_container_background1</item>
        <item name="android:textColor">@color/colorOnPrimaryContainer</item>
        <item name="hintTextColor">@color/colorSurfaceContainer</item>
    </style>


    <style name="BackgroundContainerEditText1" parent="EditTextDefault1">
        <item name="drawableTint">@color/colorOnPrimaryContainer</item>
        <item name="android:background">@drawable/bg_container_background</item>
        <item name="android:textColor">@color/colorOnBackgroundContainer</item>
        <item name="hintTextColor">@color/neutral_300</item>
    </style>

    <style name="BackgroundContainerEditText2" parent="EditTextDefault2">
        <item name="drawableTint">@color/colorOnPrimaryContainer</item>
        <item name="android:background">@drawable/bg_container_background</item>
        <item name="android:textColor">@color/colorOnBackgroundContainer</item>
        <item name="hintTextColor">@color/neutral_300</item>
    </style>

    <style name="ButtonDefault1" parent="TextMedium">
        <item name="android:layout_marginStart">@dimen/margin_start</item>
        <item name="android:layout_marginEnd">@dimen/margin_end</item>
        <item name="android:layout_marginBottom">@dimen/default_margin</item>
        <item name="android:elevation">@dimen/default_elevation</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">@dimen/default_padding_so_small</item>
    </style>

    <style name="ButtonDefault2" parent="TextMedium">
        <item name="android:layout_marginBottom">@dimen/default_margin</item>
        <item name="android:elevation">@dimen/default_elevation</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">@dimen/default_padding_so_small</item>
    </style>

    <style name="PrimaryButtonCircle" parent="ButtonDefault2">
        <item name="android:background">@drawable/primary_background_circle</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="PrimaryButtonGradient" parent="ButtonDefault1">
        <item name="android:background">@drawable/primary_background_gradient</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="PrimaryButtonGradient2" parent="ButtonDefault2">
        <item name="android:background">@drawable/primary_background_gradient</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="PrimaryButton1" parent="ButtonDefault1">
        <item name="android:background">@drawable/primary_background1</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="PrimaryButton2" parent="ButtonDefault2">
        <item name="android:background">@drawable/primary_background1</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="TertiaryButton1" parent="ButtonDefault1">
        <item name="android:background">@drawable/tertiary_background1</item>
        <item name="android:textColor">@color/colorOnTertiary</item>
    </style>

    <style name="TertiaryButton2" parent="ButtonDefault2">
        <item name="android:background">@drawable/tertiary_background1</item>
        <item name="android:textColor">@color/colorOnTertiary</item>
    </style>

    <style name="TertiaryButtonGradient1" parent="ButtonDefault1">
        <item name="android:background">@drawable/tertiary_background_gradient</item>
        <item name="android:textColor">@color/colorOnTertiary</item>
    </style>

    <style name="TertiaryButtonGradient2" parent="ButtonDefault2">
        <item name="android:background">@drawable/tertiary_background_gradient</item>
        <item name="android:textColor">@color/colorOnTertiary</item>
    </style>


    <style name="BackgroundButton1" parent="ButtonDefault1">
        <item name="android:background">@drawable/bg_background</item>
        <item name="android:textColor">@color/colorOnBackground</item>
    </style>

    <style name="BackgroundButton2" parent="ButtonDefault2">
        <item name="android:background">@drawable/bg_background</item>
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="drawableTint">@color/colorOnSurface</item>
    </style>

    <style name="SurfaceButton" parent="ButtonDefault2">
        <item name="android:background">@drawable/surface_background</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="drawableTint">@color/colorOnSurface</item>
    </style>


    <style name="SurfaceButtonCircle" parent="ButtonDefault2">
        <item name="android:background">@drawable/surface_background_circle</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="drawableTint">@color/colorOnSurface</item>
    </style>

    <style name="BaseFontText">
        <item name="autoSizeMinTextSize">@dimen/very_large_small_font</item>
        <item name="autoSizeStepGranularity">0.1sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="fontFamily">@font/font_family_moona_sans</item>
    </style>

    <style name="TextVerySmall" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/very_small_font</item>
        <item name="android:textSize">@dimen/very_small_font</item>
        <item name="fontWeight">300</item>
    </style>

    <style name="TextSmall" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/small_font</item>
        <item name="android:textSize">@dimen/small_font</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="TextMedium" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/medium_font</item>
        <item name="android:textSize">@dimen/medium_font</item>
        <item name="fontWeight">500</item>
    </style>

    <style name="TextLarge" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/large_font</item>
        <item name="android:textSize">@dimen/large_font</item>
        <item name="fontWeight">500</item>
    </style>

    <style name="TextVeryLarge" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/very_large_font</item>
        <item name="android:textSize">@dimen/very_large_font</item>
        <item name="fontWeight">700</item>
    </style>

    <style name="TextVeryLargeTop" parent="BaseFontText">
        <item name="autoSizeMaxTextSize">@dimen/very_large_top_font</item>
        <item name="android:textSize">@dimen/very_large_top_font</item>
        <item name="fontWeight">700</item>
    </style>
    <style name="ThemeOverlay.CupertinoSegmentedButton" parent="">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.MaterialButton.OutlinedButton.Cupertino</item>
    </style>

    <style name="Widget.App.MaterialButton.OutlinedButton.Cupertino" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>
    <style name="PillSearchBar" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">24dp</item>
        <item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="endIconMode">clear_text</item>
        <item name="startIconTint">?attr/colorOnSurface</item>
        <item name="endIconTint">?attr/colorOnSurface</item>
    </style>
    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>